# 训练检查点与可重新生成的模型缓存继续忽略。
/Mars-GP-IPP/data/models/generated/
*.pt
*.pth

# 精选策略归档：只保留 Msr、V2.1、V3.1 的指定检查点及说明文件。
# 必须位于 *.pt 之后，确保这些精确例外覆盖通用忽略规则。
!/Mars-GP-IPP/results/main/msr/seed_0/checkpoint.pt
!/Mars-GP-IPP/results/main/msr/seed_0/config.yaml
!/Mars-GP-IPP/results/main/msr/seed_0/metadata.json
!/Mars-GP-IPP/results/main/msr/seed_0/summary.json
!/Mars-GP-IPP/results/main/bnorm_no_mh_local_global_3x3_rbf_no_local/seed_0/checkpoint.pt
